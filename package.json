{
  "name": "standard-console",
  "version": "0.1.0",
  "private": true,
  "description": "Console Standard : Run, À décider, Preuves, Agent. Branchée sur le contrat contract/openapi.yaml.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "contract:lint": "redocly lint contract/openapi.yaml",
    "contract:types": "openapi-typescript contract/openapi.yaml -o lib/api/schema.d.ts",
    "contract:test": "vitest run",
    "contract:check": "node scripts/contract-check.mjs",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "openapi-fetch": "0.17.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.5",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "9.29.0",
    "eslint-config-next": "15.5.28",
    "js-yaml": "4.1.0",
    "openapi-typescript": "7.8.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
